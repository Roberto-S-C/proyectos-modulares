{
  "expo": {
    "name": "Proyectos Modulares CUCEI",
    "slug": "proyectos-modulares",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app-icon.png",
    "scheme": "proyectosmodulares",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cucei.proyectosmodulares",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e2b520",
        "foregroundImage": "./src/assets/images/android-icon-logo-foreground.png",
        "monochromeImage": "./src/assets/images/android-icon-logo-foreground.png"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.cucei.proyectosmodulares",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e2b520",
          "dark": {
            "backgroundColor": "#e2b520"
          }
        }
      ],
      "expo-secure-store",
      "react-native-zip-archive",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a la aplicación acceder a la galería.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#000000"
          }
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-document-picker"
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/logo.png",
          "color": "#003566",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85ca5dbd-78fb-4a52-b9b2-c04eec7b730a"
      }
    }
  }
}
